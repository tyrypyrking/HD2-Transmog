# Public-source allowlist. Unknown files, research, captures and local state stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements-dev.txt
!/src/
/src/*
!/src/*.lua
!/tests/
/tests/*
!/tests/test_*.py
!/tests/native_header_code.json
!/tools/
/tools/*
!/tools/build.py
!/tools/setup_dependencies.py
!/tools/appearance_sdk.py
!/tools/armor_catalog.py
!/tools/armor_display.py
!/tools/build_passive_icon_geometry.py
!/tools/game_automation.py
!/tools/test_creator_flow.py
!/reference/
/reference/*
!/reference/README.md
!/reference/current_catalog.json
!/reference/armor_display.json
!/reference/passive_icon_geometry_manifest.json
!/sdk/
/sdk/*
!/sdk/README.md
!/sdk/examples/
/sdk/examples/*
!/sdk/examples/ceremonial.appearances.json
!/vendor/
/vendor/*
!/vendor/LuaJIT-disassembler/
/vendor/LuaJIT-disassembler/*
!/vendor/LuaJIT-disassembler/COPYRIGHT
!/vendor/LuaJIT-disassembler/PROVENANCE.md
!/vendor/LuaJIT-disassembler/dis_x86.lua
# Defense in depth inside allowlisted directories.
**/__pycache__/
**/.env*
**/*.pem
**/*.key
**/*.log
**/*.state
**/.DS_Store
